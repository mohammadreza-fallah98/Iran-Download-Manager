{
  "manifest_version": 3,
  "name": "Iran Download Manager",
  "version": "1.0.1",
  "description": "Send download links to Iran Download Manager",
  "permissions": [
    "contextMenus",
    "downloads",
    "tabs",
    "storage",
    "cookies",
    "webRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1:6800/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js", "video.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
